<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    MSVC 툴셋을 vcpkg 와 동일하게 맞춘다.

    vcpkg 는 항상 VS 에 설치된 최신 MSVC 툴셋(Microsoft.VCToolsVersion.default.txt)으로 라이브러리를 빌드한다.
    반면 프로젝트의 PlatformToolset=v143 은 Microsoft.VCToolsVersion.v143.default.txt 를 따르는데,
    이 값이 더 오래된 툴셋(예: 14.38)으로 고정된 머신에서는 STL 버전 불일치로
    __std_find_last_of_trivial_pos_1 같은 헬퍼 심볼이 LNK2019 로 터진다.

    그래서 프로젝트도 vcpkg 와 같은 파일을 읽어 같은 툴셋을 쓰게 한다.
    VCToolsVersion 을 명시적으로 넘기면(-p:VCToolsVersion=...) 그 값이 우선한다.
  -->
  <PropertyGroup Condition="'$(VCToolsVersion)' == '' and Exists('$(VsInstallRoot)\VC\Auxiliary\Build\Microsoft.VCToolsVersion.default.txt')">
    <VCToolsVersion>$([System.IO.File]::ReadAllText('$(VsInstallRoot)\VC\Auxiliary\Build\Microsoft.VCToolsVersion.default.txt').Trim())</VCToolsVersion>
  </PropertyGroup>
</Project>
